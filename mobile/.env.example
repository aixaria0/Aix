# API Configuration
EXPO_PUBLIC_API_BASE_URL=https://api.example.com

# Internal Authentication Token
# ⚠️ SECURITY WARNING:
# EXPO_PUBLIC_* variables are compiled into the app bundle and are NOT SECRET.
# Anyone who inspects the app can extract these values.
# This configuration is for DEVELOPMENT/INTERNAL PROTOTYPE USE ONLY.
# 
# For production apps:
# - Implement secure login flow with backend authentication
# - Use per-user tokens stored in secure device storage (expo-secure-store)
# - Never embed shared/static credentials in the client app
#
# WARNING: This is a private internal app. Do not distribute outside your organization.
# Contact the platform team to obtain a valid internal authentication token.
EXPO_PUBLIC_INTERNAL_AUTH_TOKEN=
